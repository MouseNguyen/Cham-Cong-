{
  "name": "pay-slip",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p apps/attendance-ingress/tsconfig.kiosk.json && npm run build --workspace @pay-slip/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/payroll-domain/tsconfig.json && tsc --noEmit -p packages/attendance-domain/tsconfig.json && tsc --noEmit -p tests/integration/db/tsconfig.json && tsc --noEmit -p tests/integration/operations/tsconfig.json && tsc --noEmit -p tests/integration/delivery/tsconfig.json && tsc --noEmit -p tests/integration/auth/tsconfig.json && tsc --noEmit -p tests/integration/employees/tsconfig.json && tsc --noEmit -p tests/integration/attendance/tsconfig.json && tsc --noEmit -p tests/integration/pay-runs/tsconfig.json && tsc --noEmit -p apps/attendance-ingress/tsconfig.json && tsc --noEmit -p tests/integration/admin/tsconfig.json && tsc --noEmit -p packages/document-domain/tsconfig.json && tsc --noEmit -p tests/integration/documents/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/test-database.ps1 -Mode Green",
    "test:secrets": "vitest run tests/integration/operations/secrets.windows.spec.ts --maxWorkers=1 --no-file-parallelism",
    "test:secrets:identity": "vitest run tests/integration/operations/secrets.windows.identity.spec.ts --maxWorkers=1 --no-file-parallelism",
    "test:auth": "powershell -NoProfile -File scripts/windows/test-auth.ps1",
    "test:auth:browser": "powershell -NoProfile -File scripts/windows/test-auth.ps1 -Browser",
    "test:employees": "powershell -NoProfile -File scripts/windows/test-employees.ps1",
    "test:schedules": "powershell -NoProfile -File scripts/windows/test-schedules.ps1",
    "test:kiosk": "powershell -NoProfile -File scripts/windows/test-kiosk.ps1",
    "test:attendance-review": "powershell -NoProfile -File scripts/windows/test-attendance-review.ps1",
    "test:admin": "powershell -NoProfile -File scripts/windows/test-admin.ps1 -Mode Green -Browser",
    "test:documents": "powershell -NoProfile -File scripts/windows/test-documents.ps1 -Mode Green"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "fast-check": "4.9.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
