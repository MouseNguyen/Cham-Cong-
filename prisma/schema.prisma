// SQL migration additionally enforces references, checks, exclusions and triggers.
generator client {
  provider = "prisma-client"
  output = "../apps/web/src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

model organizations {
  id String @db.Uuid @id
  name String
}

model workplaces {
  id String @db.Uuid @id
  organization_id String @db.Uuid
  name String
  timezone String @default("Asia/Ho_Chi_Minh")
  @@unique([id, organization_id])
}

model opening_hour_versions {
  id String @db.Uuid @id
  organization_id String @db.Uuid
  workplace_id String @db.Uuid
  valid_from DateTime @db.Timestamptz(3)
  valid_to DateTime? @db.Timestamptz(3)
  canonical_payload String
  content_hash String
}

model public_holidays {
  id String @db.Uuid @id
  organization_id String @db.Uuid
  holiday_date DateTime @db.Date
  name String
  source_ref String
  @@unique([organization_id, holiday_date])
}

model employees {
  nationality String?
  tax_residency String?
  id String @db.Uuid @id
  organization_id String @db.Uuid
  workplace_id String @db.Uuid
  display_name String
  status String @default("active")
  @@unique([id, organization_id])
  @@unique([id, organization_id, workplace_id])
}

model users {
  employee_id String? @db.Uuid
  id String @db.Uuid @id
  organization_id String @db.Uuid
  role String
  email String
  password_hash String?
  active Boolean @default(true)
  @@unique([id, organization_id])
  @@unique([organization_id, email])
}

model employment_contracts {
  template_version String?
  probation_days Int?
  population_policy_version String?
  id String @db.Uuid @id
  organization_id String @db.Uuid
  employee_id String @db.Uuid
  kind String
  valid_from DateTime @db.Timestamptz(3)
  valid_to DateTime? @db.Timestamptz(3)
  @@unique([id, organization_id, employee_id])
}

model compensation_terms {
  id String @db.Uuid @id
  organization_id String @db.Uuid
  employee_id String @db.Uuid
  contract_id String @db.Uuid
  monthly_salary_vnd BigInt?
  hourly_rate_vnd BigInt?
  valid_from DateTime @db.Timestamptz(3)
  valid_to DateTime? @db.Timestamptz(3)
  canonical_payload String
  content_hash String
  @@unique([id, organization_id, employee_id, content_hash])
}

model delivery_destinations {
  id String @db.Uuid @id
  organization_id String @db.Uuid
  employee_id String @db.Uuid
  channel String
  address String
  valid_from DateTime @db.Timestamptz(3)
  valid_to DateTime? @db.Timestamptz(3)
  canonical_payload String
  content_hash String
  @@unique([id, organization_id, employee_id, content_hash])
}

model schedule_templates {
  id String @db.Uuid @id
  organization_id String @db.Uuid
  name String
  canonical_payload String
  content_hash String
  @@unique([id, organization_id])
}

model schedule_assignments {
